// Cooler City IMS — Prisma Schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Users & Roles ───────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  isActive      Boolean   @default(true)
  roleId        String?
  locationId    String?   // default location for this user

  role     Role?     @relation(fields: [roleId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  accounts Account[]
  sessions Session[]

  createdGRNs       GRN[]
  createdTransfers  Transfer[]
  createdRequests   StockRequest[]
  createdPOs        PurchaseOrder[]
  createdSales      Sale[]
  createdAdjustments StockAdjustment[]
  createdStockTakes StockTake[]
  auditLogs         AuditLog[]
  notifications     Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) // cannot be deleted

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id       String @id @default(cuid())
  resource String // e.g. "products", "stock", "transfers"
  action   String // e.g. "read", "create", "update", "delete", "approve"
  label    String // human-readable

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ─── Locations ───────────────────────────────────────────────────────────────

model Location {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String  @unique
  address     String?
  isActive    Boolean @default(true)
  isWarehouse Boolean @default(false)

  users        User[]
  stockEntries Stock[]
  fromTransfers Transfer[] @relation("FromLocation")
  toTransfers   Transfer[] @relation("ToLocation")
  grnItems      GRNItem[]
  adjustments   StockAdjustment[]
  stockTakes    StockTake[]
  saleItems     SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("locations")
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  parentId    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brands")
}

model Unit {
  id           String    @id @default(cuid())
  name         String    @unique // e.g. "Kilogram"
  abbreviation String    @unique // e.g. "kg"
  products     Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("units")
}

model Product {
  id              String   @id @default(cuid())
  name            String
  sku             String   @unique
  barcode         String?  @unique
  description     String?
  imageUrl        String?
  categoryId      String?
  brandId         String?
  unitId          String?
  costPrice       Decimal  @default(0) @db.Decimal(12, 4)
  sellingPrice    Decimal  @default(0) @db.Decimal(12, 4)
  reorderPoint    Int      @default(0)
  isActive        Boolean  @default(true)
  isSerialized    Boolean  @default(false) // track by serial number
  hasVariants     Boolean  @default(false)

  category Category? @relation(fields: [categoryId], references: [id])
  brand    Brand?    @relation(fields: [brandId], references: [id])
  unit     Unit?     @relation(fields: [unitId], references: [id])

  variants        ProductVariant[]
  stockEntries    Stock[]
  ledgerEntries   StockLedger[]
  grnItems        GRNItem[]
  transferItems   TransferItem[]
  requestItems    RequestItem[]
  poItems         POItem[]
  saleItems       SaleItem[]
  returnItems     ReturnItem[]
  adjustmentItems AdjustmentItem[]
  stockTakeItems  StockTakeItem[]
  serialNumbers   SerialNumber[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  name      String  // e.g. "Red / Large"
  sku       String  @unique
  barcode   String? @unique
  costPrice Decimal @default(0) @db.Decimal(12, 4)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_variants")
}

model SerialNumber {
  id        String             @id @default(cuid())
  serial    String             @unique
  productId String
  status    SerialNumberStatus @default(IN_STOCK)
  locationId String?

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("serial_numbers")
}

enum SerialNumberStatus {
  IN_STOCK
  SOLD
  TRANSFERRED
  RETURNED
}

// ─── Stock ───────────────────────────────────────────────────────────────────

model Stock {
  id         String  @id @default(cuid())
  productId  String
  locationId String
  quantity   Decimal @default(0) @db.Decimal(12, 4)

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([productId, locationId])
  @@map("stock")
}

model StockLedger {
  id            String          @id @default(cuid())
  productId     String
  locationId    String
  movementType  MovementType
  quantityIn    Decimal         @default(0) @db.Decimal(12, 4)
  quantityOut   Decimal         @default(0) @db.Decimal(12, 4)
  balanceAfter  Decimal         @db.Decimal(12, 4)
  referenceType String?         // "GRN" | "TRANSFER" | "SALE" | "ADJUSTMENT" | "RETURN" | "OPENING"
  referenceId   String?
  note          String?
  createdById   String?

  product  Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@map("stock_ledger")
}

enum MovementType {
  OPENING
  GRN_RECEIVE
  TRANSFER_OUT
  TRANSFER_IN
  SALE_ISSUE
  RETURN_IN
  ADJUSTMENT_ADD
  ADJUSTMENT_REMOVE
  STOCK_TAKE_ADJUST
}

// ─── GRN (Goods Received Note) ───────────────────────────────────────────────

model GRN {
  id           String    @id @default(cuid())
  grnNumber    String    @unique
  status       GRNStatus @default(DRAFT)
  notes        String?
  receivedDate DateTime  @default(now())
  createdById  String?

  createdBy User?    @relation(fields: [createdById], references: [id])
  items     GRNItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("grns")
}

model GRNItem {
  id        String  @id @default(cuid())
  grnId     String
  productId String
  locationId String
  quantity  Decimal @db.Decimal(12, 4)
  unitCost  Decimal @db.Decimal(12, 4)
  poItemId  String? // optional link to PO line

  grn      GRN      @relation(fields: [grnId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  poItem   POItem?  @relation(fields: [poItemId], references: [id])

  @@map("grn_items")
}

enum GRNStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

// ─── Transfers ───────────────────────────────────────────────────────────────

model Transfer {
  id               String         @id @default(cuid())
  transferNumber   String         @unique
  fromLocationId   String
  toLocationId     String
  status           TransferStatus @default(DRAFT)
  notes            String?
  createdById      String?
  approvedById     String?
  dispatchedAt     DateTime?
  receivedAt       DateTime?

  fromLocation Location @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocation   Location @relation("ToLocation", fields: [toLocationId], references: [id])
  createdBy    User?    @relation(fields: [createdById], references: [id])
  items        TransferItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transfers")
}

model TransferItem {
  id           String  @id @default(cuid())
  transferId   String
  productId    String
  quantity     Decimal @db.Decimal(12, 4)
  receivedQty  Decimal @default(0) @db.Decimal(12, 4)

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("transfer_items")
}

enum TransferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  DISPATCHED
  RECEIVED
  CANCELLED
}

// ─── Kitchen Requests ─────────────────────────────────────────────────────────

model StockRequest {
  id            String        @id @default(cuid())
  requestNumber String        @unique
  requestedById String?
  status        RequestStatus @default(PENDING)
  notes         String?

  requestedBy User?         @relation(fields: [requestedById], references: [id])
  items       RequestItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stock_requests")
}

model RequestItem {
  id          String  @id @default(cuid())
  requestId   String
  productId   String
  quantity    Decimal @db.Decimal(12, 4)
  issuedQty   Decimal @default(0) @db.Decimal(12, 4)

  request StockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@map("request_items")
}

enum RequestStatus {
  PENDING
  APPROVED
  ISSUED
  REJECTED
  CANCELLED
}

// ─── Purchase Orders ─────────────────────────────────────────────────────────

model PurchaseOrder {
  id          String   @id @default(cuid())
  poNumber    String   @unique
  status      POStatus @default(DRAFT)
  notes       String?
  createdById String?

  createdBy User?    @relation(fields: [createdById], references: [id])
  items     POItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("purchase_orders")
}

model POItem {
  id          String  @id @default(cuid())
  poId        String
  productId   String
  quantity    Decimal @db.Decimal(12, 4)
  receivedQty Decimal @default(0) @db.Decimal(12, 4)
  unitCost    Decimal @db.Decimal(12, 4)

  po      PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])
  grnItems GRNItem[]

  @@map("po_items")
}

enum POStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

// ─── Sales ───────────────────────────────────────────────────────────────────

model Sale {
  id          String     @id @default(cuid())
  saleNumber  String     @unique
  status      SaleStatus @default(DRAFT)
  notes       String?
  createdById String?

  createdBy User?      @relation(fields: [createdById], references: [id])
  items     SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sales")
}

model SaleItem {
  id         String  @id @default(cuid())
  saleId     String
  productId  String
  locationId String
  quantity   Decimal @db.Decimal(12, 4)
  unitPrice  Decimal @db.Decimal(12, 4)

  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@map("sale_items")
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

// ─── Returns ─────────────────────────────────────────────────────────────────

model Return {
  id           String       @id @default(cuid())
  returnNumber String       @unique
  type         ReturnType
  notes        String?

  items ReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("returns")
}

model ReturnItem {
  id        String  @id @default(cuid())
  returnId  String
  productId String
  quantity  Decimal @db.Decimal(12, 4)
  reason    String?

  return  Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("return_items")
}

enum ReturnType {
  CUSTOMER_RETURN
  SUPPLIER_RETURN
}

// ─── Stock Adjustments ────────────────────────────────────────────────────────

model StockAdjustment {
  id               String           @id @default(cuid())
  adjustmentNumber String           @unique
  reason           String?
  createdById      String?

  createdBy User?            @relation(fields: [createdById], references: [id])
  items     AdjustmentItem[]
  location  Location         @relation(fields: [locationId], references: [id])
  locationId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stock_adjustments")
}

model AdjustmentItem {
  id           String  @id @default(cuid())
  adjustmentId String
  productId    String
  quantity     Decimal @db.Decimal(12, 4) // positive = add, negative = remove
  note         String?

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])

  @@map("adjustment_items")
}

// ─── Stock Take ───────────────────────────────────────────────────────────────

model StockTake {
  id          String          @id @default(cuid())
  reference   String          @unique
  locationId  String
  status      StockTakeStatus @default(IN_PROGRESS)
  notes       String?
  createdById String?
  approvedById String?
  completedAt DateTime?

  location  Location      @relation(fields: [locationId], references: [id])
  createdBy User?         @relation(fields: [createdById], references: [id])
  items     StockTakeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stock_takes")
}

model StockTakeItem {
  id           String  @id @default(cuid())
  stockTakeId  String
  productId    String
  systemQty    Decimal @db.Decimal(12, 4)
  countedQty   Decimal @db.Decimal(12, 4)
  variance     Decimal @db.Decimal(12, 4) // countedQty - systemQty
  note         String?

  stockTake StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@map("stock_take_items")
}

enum StockTakeStatus {
  IN_PROGRESS
  PENDING_APPROVAL
  APPROVED
  CANCELLED
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   // "LOW_STOCK" | "TRANSFER" | "REQUEST" | "SYSTEM"
  isRead    Boolean  @default(false)
  link      String?  // deep link into the app

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("notifications")
}

// ─── Audit Logs ───────────────────────────────────────────────────────────────

model AuditLog {
  id          String @id @default(cuid())
  userId      String?
  action      String  // "CREATE" | "UPDATE" | "DELETE" | "LOGIN" | ...
  resource    String  // "Product" | "Transfer" | ...
  resourceId  String?
  oldData     Json?
  newData     Json?
  ipAddress   String?

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// ─── Settings ────────────────────────────────────────────────────────────────

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text

  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Sequence {
  id      String @id @default(cuid())
  prefix  String @unique // "GRN" | "TRF" | "PO" | "SALE" | "ADJ"
  current Int    @default(0)
  padding Int    @default(4) // zero-pad to this width

  @@map("sequences")
}
